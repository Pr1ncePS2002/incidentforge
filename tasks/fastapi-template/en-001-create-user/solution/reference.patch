diff --git a/backend/app/core/naming.py b/backend/app/core/naming.py
new file mode 100644
index 0000000..4bfa428
--- /dev/null
+++ b/backend/app/core/naming.py
@@ -0,0 +1,51 @@
+"""Environment-scoped names for shared caches, queues and topics.
+
+Every key, queue or topic name that may live on infrastructure shared between
+deployments must be built here so it always carries the configured environment.
+"""
+
+from typing import Any
+
+from app.core import config
+
+ENV_SETTING = "FASTAPI_ENV"
+ALLOWED_ENVIRONMENTS = frozenset({"local", "development", "staging", "production"})
+SEPARATOR = ":"
+
+
+def current_environment() -> str:
+    """Return the configured environment, failing fast if it is unusable."""
+    env = getattr(config.settings, ENV_SETTING, None)
+    if not isinstance(env, str) or not env.strip():
+        raise ValueError(
+            f"{ENV_SETTING} must be set to one of {sorted(ALLOWED_ENVIRONMENTS)}, got {env!r}"
+        )
+    if env not in ALLOWED_ENVIRONMENTS:
+        raise ValueError(
+            f"{ENV_SETTING}={env!r} is not an allowed environment; "
+            f"expected one of {sorted(ALLOWED_ENVIRONMENTS)}"
+        )
+    return env
+
+
+def scoped_name(*parts: Any) -> str:
+    """Build ``<env>:<part>:<part>...`` from the configured environment."""
+    if not parts:
+        raise ValueError("scoped_name needs at least one part")
+    env = current_environment()
+    rendered: list[str] = []
+    for part in parts:
+        text = str(part)
+        if not text:
+            raise ValueError("name parts must not be empty")
+        if SEPARATOR in text:
+            raise ValueError(
+                f"name part {text!r} must not contain the separator {SEPARATOR!r}"
+            )
+        rendered.append(text)
+    return SEPARATOR.join([env, *rendered])
+
+
+def user_cache_key(user_id: Any) -> str:
+    """Cache key for a single user record."""
+    return scoped_name("user", user_id)
