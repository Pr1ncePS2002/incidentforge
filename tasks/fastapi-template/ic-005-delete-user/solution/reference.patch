diff --git a/backend/app/core/idempotency.py b/backend/app/core/idempotency.py
new file mode 100644
index 0000000..a389974
--- /dev/null
+++ b/backend/app/core/idempotency.py
@@ -0,0 +1,45 @@
+"""Process-local idempotency records for retried mutating requests."""
+
+import threading
+import uuid
+from dataclasses import dataclass, field
+from typing import Any
+
+
+@dataclass(frozen=True)
+class IdempotencyRecord:
+    target_id: uuid.UUID
+    result: dict[str, Any]
+
+
+@dataclass
+class IdempotencyStore:
+    """Remembers the outcome of each successfully applied idempotency key."""
+
+    _records: dict[str, IdempotencyRecord] = field(default_factory=dict)
+    _key_locks: dict[str, threading.Lock] = field(default_factory=dict)
+    _guard: threading.Lock = field(default_factory=threading.Lock)
+
+    def lock_for(self, key: str) -> threading.Lock:
+        with self._guard:
+            lock = self._key_locks.get(key)
+            if lock is None:
+                lock = threading.Lock()
+                self._key_locks[key] = lock
+            return lock
+
+    def get(self, key: str) -> IdempotencyRecord | None:
+        with self._guard:
+            return self._records.get(key)
+
+    def put(self, key: str, target_id: uuid.UUID, result: dict[str, Any]) -> None:
+        with self._guard:
+            self._records[key] = IdempotencyRecord(target_id, dict(result))
+
+    def clear(self) -> None:
+        with self._guard:
+            self._records.clear()
+            self._key_locks.clear()
+
+
+delete_user_idempotency = IdempotencyStore()
