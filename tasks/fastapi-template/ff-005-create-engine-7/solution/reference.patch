index 095f72e..8dbd50d 100644
--- a/backend/app/core/config.py
+++ b/backend/app/core/config.py
@@ -54,6 +54,39 @@ class Settings(BaseSettings):
             self.EMAILS_FROM_NAME = self.PROJECT_NAME
         return self
 
+    # TLS to the database; the root certificate is required once it is enabled
+    DATABASE_SSL_ENABLED: bool = False
+    DATABASE_SSL_ROOT_CERT: str | None = None
+
+    @model_validator(mode="after")
+    def _enforce_database_auth_settings(self) -> Self:
+        # a half-configured database connection used to start fine and fail on the
+        # first query (or connect without credentials); refuse to start instead
+        from sqlalchemy.engine import make_url
+
+        placeholders = {"changethis", "change-me", "changeme", "todo", "tbd", "fixme"}
+        problems: list[str] = []
+        url = make_url(str(self.DATABASE_URL))
+        if not (url.username or "").strip():
+            problems.append("DATABASE_URL must include a database user")
+        if not (url.password or "").strip():
+            problems.append("DATABASE_URL must include a non-empty password")
+        if self.DATABASE_SSL_ENABLED:
+            cert = (self.DATABASE_SSL_ROOT_CERT or "").strip()
+            if not cert:
+                problems.append(
+                    "DATABASE_SSL_ROOT_CERT is required when DATABASE_SSL_ENABLED is on"
+                )
+            elif cert.lower() in placeholders or (
+                cert.startswith("<") and cert.endswith(">")
+            ):
+                problems.append(
+                    f"DATABASE_SSL_ROOT_CERT still holds a placeholder ({cert!r})"
+                )
+        if problems:
+            raise ValueError("invalid database configuration: " + "; ".join(problems))
+        return self
+
     EMAIL_RESET_TOKEN_EXPIRE_HOURS: int = 48
 
     @computed_field  # type: ignore[prop-decorator]
