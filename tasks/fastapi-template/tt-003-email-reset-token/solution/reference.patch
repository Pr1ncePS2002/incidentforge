diff --git a/backend/app/core/config.py b/backend/app/core/config.py
index 095f72e..31c0e63 100644
--- a/backend/app/core/config.py
+++ b/backend/app/core/config.py
@@ -56,6 +56,54 @@ class Settings(BaseSettings):
 
     EMAIL_RESET_TOKEN_EXPIRE_HOURS: int = 48
 
+    # extra recipients blind-copied on every outgoing email, e.g. an audit mailbox
+    EMAILS_BCC: list[EmailStr] | str = []
+
+    @field_validator("EMAILS_BCC", mode="before")
+    @classmethod
+    def _parse_emails_bcc(cls, value: object) -> list[str]:
+        # operators write lists as "a, b", '["a", "b"]' or leave them empty; accept
+        # all of them and reject anything else with the key and the offending value
+        import json
+
+        from email_validator import EmailNotValidError, validate_email
+
+        raw = value
+        if value is None:
+            return []
+        if isinstance(value, str):
+            text = value.strip()
+            if not text:
+                return []
+            if text.startswith("["):
+                try:
+                    value = json.loads(text)
+                except ValueError:
+                    raise ValueError(
+                        f"EMAILS_BCC: {raw!r} is not a valid JSON array"
+                    ) from None
+            else:
+                value = [part.strip() for part in text.split(",") if part.strip()]
+        if not isinstance(value, list | tuple):
+            raise ValueError(
+                f"EMAILS_BCC: {raw!r} is not a list of email addresses"
+            )
+        emails: list[str] = []
+        for item in value:
+            if not isinstance(item, str):
+                raise ValueError(
+                    f"EMAILS_BCC: {item!r} in {raw!r} is not an email address"
+                )
+            address = item.strip()
+            try:
+                validate_email(address, check_deliverability=False)
+            except EmailNotValidError:
+                raise ValueError(
+                    f"EMAILS_BCC: {address!r} in {raw!r} is not a valid email address"
+                ) from None
+            emails.append(address)
+        return emails
+
     @computed_field  # type: ignore[prop-decorator]
     @property
     def emails_enabled(self) -> bool:
