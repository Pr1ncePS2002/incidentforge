index 0000000..2702abd
--- /dev/null
+++ b/backend/app/core/idempotency.py
@@ -0,0 +1,34 @@
+"""Process-local ledger of idempotency keys whose effect has already been applied."""
+
+import threading
+from collections import OrderedDict
+from collections.abc import Hashable, Iterator
+from contextlib import contextmanager
+
+
+class IdempotencyLedger:
+    """Remembers which (scope, key) pairs have been applied, oldest evicted first."""
+
+    def __init__(self, max_entries: int = 100_000) -> None:
+        self._max_entries = max_entries
+        self._applied: OrderedDict[tuple[str, str], None] = OrderedDict()
+        self._lock = threading.Lock()
+
+    @contextmanager
+    def claim(self, scope: Hashable, key: str) -> Iterator[bool]:
+        """Yield whether ``key`` was already applied within ``scope``.
+
+        The key is recorded only if the body finishes without raising, so a
+        failed attempt stays retryable. The lock is held for the whole body,
+        so two deliveries of the same key can never both apply.
+        """
+        marker = (str(scope), key)
+        with self._lock:
+            yield marker in self._applied
+            self._applied[marker] = None
+            self._applied.move_to_end(marker)
+            while len(self._applied) > self._max_entries:
+                self._applied.popitem(last=False)
+
+
+user_update_ledger = IdempotencyLedger()
