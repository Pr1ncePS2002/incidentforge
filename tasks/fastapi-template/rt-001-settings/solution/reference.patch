+"""Lossless load / modify / save for the dotenv file that ``Settings`` reads.
+
+``update_env_file`` rewrites only the assignments it is asked to change: comments,
+blank lines, ordering, unknown keys and untouched values stay byte-for-byte as they
+were, explicit empty values stay distinct from unset ones, and the file is replaced
+atomically so a failed save leaves the previous file intact.
+"""
+
+import contextlib
+import json
+import os
+import re
+import stat
+import tempfile
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any
+
+_KEY_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
+_ASSIGN_RE = re.compile(r"^(\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*)(.*)$")
+_SAFE_RE = re.compile(r"[A-Za-z0-9_\-.,:/@+%]+")
+_DOUBLE_ESCAPES = {
+    "\\": "\\",
+    "'": "'",
+    '"': '"',
+    "a": "\a",
+    "b": "\b",
+    "f": "\f",
+    "n": "\n",
+    "r": "\r",
+    "t": "\t",
+    "v": "\v",
+}
+_SINGLE_ESCAPES = {"\\": "\\", "'": "'"}
+
+
+def _split_lines(text: str) -> list[str]:
+    parts = text.split("\n")
+    lines = [part + "\n" for part in parts[:-1]]
+    if parts[-1]:
+        lines.append(parts[-1])
+    return lines
+
+
+def _strip_ending(line: str) -> tuple[str, str]:
+    body = line[:-1] if line.endswith("\n") else line
+    if body.endswith("\r"):
+        body = body[:-1]
+    return body, line[len(body) :]
+
+
+def _unquote(raw: str, quote: str, escapes: Mapping[str, str]) -> str:
+    out: list[str] = []
+    i = 1
+    while i < len(raw):
+        ch = raw[i]
+        if ch == "\\" and i + 1 < len(raw) and raw[i + 1] in escapes:
+            out.append(escapes[raw[i + 1]])
+            i += 2
+            continue
+        if ch == quote:
+            break
+        out.append(ch)
+        i += 1
+    return "".join(out)
+
+
+def _parse_value(raw: str) -> str:
+    raw = raw.strip()
+    if raw.startswith('"'):
+        return _unquote(raw, '"', _DOUBLE_ESCAPES)
+    if raw.startswith("'"):
+        return _unquote(raw, "'", _SINGLE_ESCAPES)
+    comment = re.search(r"\s#", raw)
+    if comment:
+        raw = raw[: comment.start()]
+    return raw.strip()
+
+
+def _parse_line(body: str) -> tuple[str, str, str] | None:
+    if body.lstrip().startswith("#"):
+        return None
+    match = _ASSIGN_RE.match(body)
+    if match is None:
+        return None
+    return match.group(2), _parse_value(match.group(3)), match.group(1)
+
+
+def _serialise(key: str, value: Any) -> str | None:
+    if value is None:
+        return None
+    if isinstance(value, bool):
+        return "true" if value else "false"
+    if isinstance(value, int | float):
+        return str(value)
+    if isinstance(value, str):
+        return value
+    if isinstance(value, list | tuple | dict):
+        return json.dumps(value)
+    raise TypeError(f"cannot store {key}: unsupported type {type(value).__name__}")
+
+
+def _format(value: str) -> str:
+    if value == "" or _SAFE_RE.fullmatch(value):
+        return value
+    if not any(ch in value for ch in "'\\\n\r"):
+        return f"'{value}'"
+    escaped = (
+        value.replace("\\", "\\\\")
+        .replace('"', '\\"')
+        .replace("\n", "\\n")
+        .replace("\r", "\\r")
+    )
+    return f'"{escaped}"'
+
+
+def _read_text(target: Path) -> str | None:
+    try:
+        with open(target, encoding="utf-8", newline="") as handle:
+            return handle.read()
+    except FileNotFoundError:
+        return None
+
+
+def read_env_file(path: str | os.PathLike[str]) -> dict[str, str]:
+    """Return every assignment in the file; ``KEY=`` maps to ``""``, absent keys are absent."""
+    values: dict[str, str] = {}
+    for line in _split_lines(_read_text(Path(path)) or ""):
+        parsed = _parse_line(_strip_ending(line)[0])
+        if parsed is not None:
+            values[parsed[0]] = parsed[1]
+    return values
+
+
+def _atomic_write(target: Path, text: str) -> None:
+    fd, tmp_name = tempfile.mkstemp(
+        dir=target.parent, prefix=f".{target.name}.", suffix=".tmp"
+    )
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", newline="") as handle:
+            handle.write(text)
+            handle.flush()
+            os.fsync(handle.fileno())
+        with contextlib.suppress(FileNotFoundError):
+            os.chmod(tmp_name, stat.S_IMODE(os.stat(target).st_mode))
+        os.replace(tmp_name, target)
+    except BaseException:
+        with contextlib.suppress(FileNotFoundError):
+            os.unlink(tmp_name)
+        raise
+
+
+def update_env_file(path: str | os.PathLike[str], changes: Mapping[str, Any]) -> None:
+    """Apply ``changes`` to the dotenv file at ``path``; everything else stays as is.
+
+    ``None`` removes a key (unset), ``""`` writes an explicit empty value. Values are
+    validated before the file is touched and the file is replaced atomically.
+    """
+    target = Path(path)
+    rendered: dict[str, str | None] = {}
+    for key, value in changes.items():
+        if not isinstance(key, str) or not _KEY_RE.fullmatch(key):
+            raise ValueError(f"invalid setting name: {key!r}")
+        rendered[key] = _serialise(key, value)
+
+    original = _read_text(target)
+    out: list[str] = []
+    seen: set[str] = set()
+    for line in _split_lines(original or ""):
+        body, ending = _strip_ending(line)
+        parsed = _parse_line(body)
+        if parsed is None or parsed[0] not in rendered:
+            out.append(line)
+            continue
+        key, current, prefix = parsed
+        seen.add(key)
+        new = rendered[key]
+        if new is None:
+            continue
+        out.append(line if new == current else f"{prefix}{_format(new)}{ending}")
+
+    added = [k for k, v in rendered.items() if k not in seen and v is not None]
+    if added:
+        if out and not out[-1].endswith("\n"):
+            out[-1] += "\n"
+        out.extend(f"{k}={_format(rendered[k] or '')}\n" for k in added)
+
+    text = "".join(out)
+    if text == (original if original is not None else ""):
+        return
+    _atomic_write(target, text)
