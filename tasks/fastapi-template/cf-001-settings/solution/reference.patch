+    @model_validator(mode="after")
+    def _enforce_consistent_token_and_smtp_settings(self) -> Self:
+        # each value is valid alone; reject combinations that cannot work together
+        problems: list[str] = []
+        access = self.ACCESS_TOKEN_EXPIRE_MINUTES
+        reset = self.EMAIL_RESET_TOKEN_EXPIRE_HOURS
+        if access <= 0:
+            problems.append(f"ACCESS_TOKEN_EXPIRE_MINUTES must be positive, got {access}")
+        if reset <= 0:
+            problems.append(f"EMAIL_RESET_TOKEN_EXPIRE_HOURS must be positive, got {reset}")
+        if access > 0 and reset > 0 and reset * 60 > access:
+            problems.append(
+                f"EMAIL_RESET_TOKEN_EXPIRE_HOURS ({reset}h = {reset * 60} min) must not "
+                f"exceed ACCESS_TOKEN_EXPIRE_MINUTES ({access} min)"
+            )
+        if self.SMTP_TLS and self.SMTP_SSL:
+            problems.append("SMTP_TLS and SMTP_SSL cannot both be enabled")
+        if problems:
+            raise ValueError("inconsistent settings: " + "; ".join(problems))
+        return self
