@@ -0,0 +1,8 @@
+"""In-process stand-in for the shared message broker used for user change events."""
+
+published: list[tuple[str, str]] = []
+
+
+def publish(topic: str, key: str) -> None:
+    """Record one message for `topic` keyed by `key`."""
+    published.append((topic, key))
diff --git a/backend/app/core/naming.py b/backend/app/core/naming.py
new file mode 100644
index 0000000..6ed8821
--- /dev/null
+++ b/backend/app/core/naming.py
@@ -0,0 +1,30 @@
+"""Environment-scoped names for shared cache keys, broker topics and queues."""
+
+from app.core import config
+
+ENV_SETTING = "FASTAPI_ENV"
+ALLOWED_ENVIRONMENTS: frozenset[str] = frozenset({"development", "staging", "production"})
+SEPARATOR = ":"
+
+
+def current_environment() -> str:
+    """Return the configured environment, failing fast if it is empty or unknown."""
+    env = getattr(config.settings, ENV_SETTING, None)
+    if not isinstance(env, str) or env not in ALLOWED_ENVIRONMENTS:
+        allowed = ", ".join(sorted(ALLOWED_ENVIRONMENTS))
+        raise ValueError(f"{ENV_SETTING} must be one of: {allowed} (got {env!r})")
+    return env
+
+
+def scoped_name(*parts: str) -> str:
+    """Build '<env>:<part>:...' for a shared resource; parts may not contain ':'."""
+    if not parts:
+        raise ValueError("scoped_name requires at least one name part")
+    for part in parts:
+        if not isinstance(part, str) or not part:
+            raise ValueError(f"name parts must be non-empty strings, got {part!r}")
+        if SEPARATOR in part:
+            raise ValueError(
+                f"name part {part!r} contains the separator {SEPARATOR!r}"
+            )
+    return SEPARATOR.join((current_environment(), *parts))
