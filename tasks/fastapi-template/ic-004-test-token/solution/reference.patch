+++ b/backend/app/core/token_audit.py
@@ -0,0 +1,56 @@
+"""In-process audit log of access-token checks (POST /login/test-token).
+
+Clients retry the check on timeouts, so a check carrying an Idempotency-Key is
+recorded once per (user, key); repeats get the original event back.
+"""
+
+import threading
+import uuid
+from dataclasses import dataclass
+from datetime import datetime, timezone
+
+
+@dataclass(frozen=True)
+class TokenCheckEvent:
+    id: uuid.UUID
+    user_id: uuid.UUID
+    idempotency_key: str | None
+    created_at: datetime
+
+
+_lock = threading.Lock()
+_events: list[TokenCheckEvent] = []
+_by_key: dict[tuple[uuid.UUID, str], TokenCheckEvent] = {}
+
+
+def record_token_check(
+    user_id: uuid.UUID, idempotency_key: str | None
+) -> tuple[TokenCheckEvent, bool]:
+    """Record a check; return (event, replayed). Keyed repeats are not re-recorded."""
+    # check-and-insert under one lock so concurrent duplicates cannot both apply
+    with _lock:
+        if idempotency_key is not None:
+            existing = _by_key.get((user_id, idempotency_key))
+            if existing is not None:
+                return existing, True
+        event = TokenCheckEvent(
+            id=uuid.uuid4(),
+            user_id=user_id,
+            idempotency_key=idempotency_key,
+            created_at=datetime.now(timezone.utc),
+        )
+        _events.append(event)
+        if idempotency_key is not None:
+            _by_key[(user_id, idempotency_key)] = event
+        return event, False
+
+
+def list_token_checks(user_id: uuid.UUID | None = None) -> list[TokenCheckEvent]:
+    with _lock:
+        return [e for e in _events if user_id is None or e.user_id == user_id]
+
+
+def reset_token_checks() -> None:
+    with _lock:
+        _events.clear()
+        _by_key.clear()
