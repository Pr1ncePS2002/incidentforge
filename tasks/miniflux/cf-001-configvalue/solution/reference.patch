diff --git a/internal/config/parser.go b/internal/config/parser.go
index cb78f8b0..6033e092 100644
--- a/internal/config/parser.go
+++ b/internal/config/parser.go
@@ -52,6 +52,23 @@ func (cp *configParser) ParseFile(filename string) (*configOptions, error) {
 
 // Validate checks for invalid or incomplete option combinations.
 func (c *configOptions) Validate() error {
+	if c.SchedulerEntryFrequencyMinInterval() > c.SchedulerEntryFrequencyMaxInterval() {
+		return fmt.Errorf("SCHEDULER_ENTRY_FREQUENCY_MIN_INTERVAL (%v) must not be greater than SCHEDULER_ENTRY_FREQUENCY_MAX_INTERVAL (%v)", c.SchedulerEntryFrequencyMinInterval(), c.SchedulerEntryFrequencyMaxInterval())
+	}
+
+	if c.CertDomain() != "" {
+		var conflicting []string
+		if c.CertFile() != "" {
+			conflicting = append(conflicting, "CERT_FILE")
+		}
+		if c.CertKeyFile() != "" {
+			conflicting = append(conflicting, "KEY_FILE")
+		}
+		if len(conflicting) > 0 {
+			return fmt.Errorf("CERT_DOMAIN cannot be combined with %s: choose either automatic certificates or manually supplied certificate files", strings.Join(conflicting, " and "))
+		}
+	}
+
 	if c.OAuth2Provider() == "oidc" && c.OAuth2OIDCDiscoveryEndpoint() == "" {
 		return errors.New("OAUTH2_OIDC_DISCOVERY_ENDPOINT must be configured when using the OIDC provider")
 	}
