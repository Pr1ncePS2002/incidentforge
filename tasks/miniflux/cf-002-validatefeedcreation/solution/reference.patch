+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package validator // import "miniflux.app/v2/internal/validator"
+
+import (
+	"errors"
+	"strings"
+
+	"miniflux.app/v2/internal/model"
+)
+
+// ValidateFeedRuleCombination rejects entry filter rules that cannot work
+// together. Miniflux applies the blocklist first and then drops every entry
+// that does not match the keeplist, so identical non-empty rules remove every
+// entry of the feed.
+func ValidateFeedRuleCombination(request *model.FeedCreationRequest) error {
+	if request == nil {
+		return nil
+	}
+
+	blocklistRules := strings.TrimSpace(request.BlocklistRules)
+	keeplistRules := strings.TrimSpace(request.KeeplistRules)
+	if blocklistRules != "" && blocklistRules == keeplistRules {
+		return errors.New("blocklist_rules and keeplist_rules must not be identical: every entry of the feed would be removed")
+	}
+
+	return nil
+}
