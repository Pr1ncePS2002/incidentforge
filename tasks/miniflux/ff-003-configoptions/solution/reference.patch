+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package config // import "miniflux.app/v2/internal/config"
+
+import (
+	"fmt"
+	"strings"
+)
+
+var placeholderSettingValues = map[string]struct{}{
+	"changethis":  {},
+	"changeme":    {},
+	"change-me":   {},
+	"todo":        {},
+	"tbd":         {},
+	"fixme":       {},
+	"placeholder": {},
+	"xxx":         {},
+}
+
+func isPlaceholderSettingValue(value string) bool {
+	v := strings.ToLower(strings.TrimSpace(value))
+	if v == "" {
+		return false
+	}
+	if _, found := placeholderSettingValues[v]; found {
+		return true
+	}
+	return strings.HasPrefix(v, "<") && strings.HasSuffix(v, ">")
+}
+
+// validateTLSCertificateFiles ensures CERT_FILE and KEY_FILE are configured together with real values.
+func (c *configOptions) validateTLSCertificateFiles() error {
+	settings := []struct {
+		key   string
+		value string
+	}{
+		{"CERT_FILE", strings.TrimSpace(c.CertFile())},
+		{"KEY_FILE", strings.TrimSpace(c.CertKeyFile())},
+	}
+
+	if settings[0].value == "" && settings[1].value == "" {
+		return nil
+	}
+
+	var problems []string
+	for _, setting := range settings {
+		switch {
+		case setting.value == "":
+			problems = append(problems, setting.key+" is missing or empty")
+		case isPlaceholderSettingValue(setting.value):
+			problems = append(problems, fmt.Sprintf("%s still holds the placeholder value %q", setting.key, setting.value))
+		}
+	}
+
+	if len(problems) == 0 {
+		return nil
+	}
+	return fmt.Errorf("invalid TLS certificate settings: %s", strings.Join(problems, "; "))
+}
