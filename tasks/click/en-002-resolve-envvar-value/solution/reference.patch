+    def get_auto_envvar_name(self, ctx: Context) -> str | None:
+        """Return the name of the environment variable this option reads
+        through :attr:`Context.auto_envvar_prefix`, or ``None`` if automatic
+        environment variables do not apply to it.
+
+        The name is built as ``{PREFIX}_{NAME}``. Any character of the prefix
+        or the option name that is not a letter, digit or underscore is
+        replaced with an underscore, so the result is always a valid
+        environment variable name.
+
+        :param ctx: The context whose prefix scopes the name.
+        :raises ValueError: If the prefix contains no letter or digit.
+        """
+        prefix = ctx.auto_envvar_prefix
+
+        if self.allow_from_autoenv and prefix is not None and self.name:
+            if not any(c.isalnum() for c in prefix):
+                raise ValueError(
+                    f"Invalid 'auto_envvar_prefix' {prefix!r} for option"
+                    f" {self.name!r}: the prefix must contain at least one"
+                    " letter or digit."
+                )
+
+            def normalize(value: str) -> str:
+                return "".join(c if c.isalnum() or c == "_" else "_" for c in value)
+
+            return f"{normalize(prefix)}_{normalize(self.name.upper())}"
+
+        return None
+
