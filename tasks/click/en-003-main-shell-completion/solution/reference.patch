+    def get_complete_var(self, prog_name: str) -> str:
+        """Return the name of the environment variable that holds the
+        shell completion instruction for this command when it is run as
+        ``prog_name``. Override this in a subclass to use a different
+        name.
+
+        Every character that is not an ASCII letter, digit or underscore
+        is replaced with an underscore and the result is upper-cased, so
+        ``foo-bar.baz`` becomes ``_FOO_BAR_BAZ_COMPLETE``.
+
+        :param prog_name: Name of the executable in the shell.
+        :raises ValueError: if ``prog_name`` does not contain at least
+            one ASCII letter or digit.
+        """
+        import re
+
+        if re.search(r"[A-Za-z0-9]", prog_name) is None:
+            raise ValueError(
+                f"prog_name {prog_name!r} cannot be used to build the shell"
+                " completion variable name, it must contain at least one"
+                " ASCII letter or digit."
+            )
+
+        complete_name = re.sub(r"[^A-Za-z0-9_]", "_", prog_name)
+        return f"_{complete_name}_COMPLETE".upper()
+
