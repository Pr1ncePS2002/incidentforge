+    def split_envvar_value(self, rv: str) -> cabc.Sequence[str]:
+        """Split an environment variable value into datetime strings.
+
+        A value that starts with ``[`` is parsed as a JSON array of
+        strings. A value that contains a comma is split on commas and
+        each item is stripped of surrounding whitespace. Any other value
+        is split on whitespace, as before.
+        """
+        stripped = rv.strip()
+
+        if stripped.startswith("["):
+            import json
+
+            try:
+                items = json.loads(stripped)
+            except ValueError:
+                items = None
+
+            if not isinstance(items, list) or not all(
+                isinstance(item, str) for item in items
+            ):
+                self.fail(
+                    _("{value!r} is not a valid JSON list of strings.").format(
+                        value=rv
+                    )
+                )
+
+            return [item.strip() for item in items]
+
+        if "," in stripped:
+            return [item.strip() for item in stripped.split(",")]
+
+        return super().split_envvar_value(rv)
+
