{
  "name": "incidentforge",
  // python 3.12 image pinned by digest (tag 3.3.4-3.12-bookworm); docker-in-docker runs the task containers
  "image": "mcr.microsoft.com/devcontainers/python:3.3.4-3.12-bookworm@sha256:810cf704128b9d4fa64dc14576335655340871e7a2c046bb08f7952549cb92c5",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {}
  },
  // the fastapi task image runs postgres next to the app, so 2 cores / 4 gb is too tight
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "postCreateCommand": "pip install --no-cache-dir uv==0.11.17 && uv sync && uv tool install harbor==0.25.0",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
